{
  "name": "desktop-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/desktop-e2e/src",
  "implicitDependencies": ["desktop", "web"],
  "targets": {
    "e2e": {
      "executor": "@nx/playwright:playwright",
      "outputs": [
        "{workspaceRoot}/apps/desktop-e2e/playwright-report",
        "{workspaceRoot}/apps/desktop-e2e/test-results"
      ],
      "dependsOn": ["desktop:build", "web:build"],
      "options": {
        "config": "apps/desktop-e2e/playwright.config.ts",
        "skipInstall": true
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  },
  "tags": []
}
