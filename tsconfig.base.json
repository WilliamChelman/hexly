{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@hexly/domain": ["./libs/domain/src/index.ts"],
      "@hexly/immer": ["./libs/immer/src/index.ts"],
      "@hexly/obsidian": ["./libs/obsidian/src/index.ts"],
      "@hexly/web-core": ["./libs/web-core/src/index.ts"],
      "@hexly/web-core/testing": ["./libs/web-core/src/testing/index.ts"],
      "@hexly/web-ui": ["./libs/web-ui/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
