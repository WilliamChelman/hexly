{
  "name": "@hexly/source",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "HEXLY_DIR=hexly-data nx run-many -t serve -p api,web",
    "dev:api": "HEXLY_DIR=hexly-data nx serve api",
    "dev:web": "nx serve web",
    "seed": "nx build api && HEXLY_DIR=hexly-data node dist/apps/api/seed.js",
    "db:generate": "cd apps/api && drizzle-kit generate",
    "db:check": "node scripts/check-drizzle-migrations.mjs",
    "build": "nx run-many -t build -p api,web",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "test:eslint-rules": "node --test eslint-rules/*.spec.mjs",
    "e2e": "nx e2e web-e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "private": true,
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "better-sqlite3",
      "esbuild",
      "lmdb",
      "msgpackr-extract",
      "nx",
      "unrs-resolver"
    ]
